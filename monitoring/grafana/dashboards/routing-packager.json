{
  "uid": "routing-packager",
  "title": "Routing Graph Packager",
  "tags": ["routing-packager"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests",
      "description": "Request rate per status code.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(rgp_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP p95 latency",
      "description": "95th percentile request duration per endpoint.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(rgp_http_duration_seconds_bucket[5m])))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Packaging jobs",
      "description": "Jobs finished per bar. 'created' is a new package a user asked for; 'updated' is an existing one re-zipped by update_all_packages after a graph swap.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (increase(rgp_package_total{update=\"false\"}[$__interval]))",
          "interval": "1m",
          "legendFormat": "created, {{outcome}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (increase(rgp_package_total{update=\"true\"}[$__interval]))",
          "interval": "1m",
          "legendFormat": "updated, {{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Packaging duration",
      "description": "How long it takes to zip a package out of the current graph generation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(rgp_package_duration_seconds_bucket[6h])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rgp_package_duration_seconds_bucket[6h])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Graph build stages, mean duration",
      "description": "The builder's own stages (prune, PBF download and update, swap) next to the stages valhalla_build_tiles reports for itself.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (stage) (rgp_build_stage_duration_seconds_sum) / sum by (stage) (rgp_build_stage_duration_seconds_count)",
          "legendFormat": "{{stage}}",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "valhalla_build_stage_duration_seconds{module!=\"util\"}",
          "legendFormat": "valhalla {{module}}.{{stage}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Graph builds, last 30 days",
      "description": "A skipped run found the build lock held by another builder and did nothing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (increase(rgp_build_total[30d]))",
          "legendFormat": "{{outcome}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Mean successful build",
      "description": "Wall clock of a full graph build, prune to symlink swap.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 16
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(rgp_build_duration_seconds_sum{outcome=\"succeeded\"}[30d])) / sum(rate(rgp_build_duration_seconds_count{outcome=\"succeeded\"}[30d]))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 8,
      "type": "state-timeline",
      "title": "Graph build stage",
      "description": "Which step the builder is on, over time. Every row reads idle when no build is running. A row that stays lit is a stage that is taking a long time, which on a planet build is normal for building_tiles.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.9,
        "alignValue": "center",
        "legend": {
          "displayMode": "hidden"
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "idle",
                  "color": "transparent",
                  "index": 0
                },
                "1": {
                  "text": "running",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
          "expr": "rgp_graph_build_stage",
          "legendFormat": "{{stage}}",
          "interval": "1m"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Build state",
      "description": "idle between builds, building during one, failed when the last one gave up, unknown before the builder has ever run.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 12,
        "y": 24
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "name",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
          "expr": "rgp_graph_build_state == 1",
          "legendFormat": "{{state}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Next build in",
      "description": "Counts down to the next GRAPH_BUILD_CRON occurrence. Blank while a build is running, and blank when the builder runs with --once, since something outside it owns the schedule.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 6,
        "x": 18,
        "y": 24
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
          "expr": "rgp_graph_build_next_timestamp_seconds - time()",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Worker queue",
      "description": "queued counts everything on the queue; claimed is how many have an in-progress lock; waiting is the difference. claimed staying high while ongoing reads 0 means a worker died mid-job and its lock has not expired yet.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
          "expr": "rgp_worker_queued",
          "legendFormat": "queued",
          "interval": "1m"
        },
        {
          "refId": "B",
          "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
          "expr": "rgp_worker_ongoing",
          "legendFormat": "ongoing",
          "interval": "1m"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rgp_worker_in_progress",
          "legendFormat": "claimed",
          "interval": "1m"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rgp_worker_queued - rgp_worker_in_progress",
          "legendFormat": "waiting",
          "interval": "1m"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Worker jobs",
      "description": "Jobs the worker finished per bar, as ARQ counts them. These are the worker's own totals, so they reset when it restarts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
          "expr": "increase(rgp_worker_jobs_complete_total[$__interval])",
          "legendFormat": "complete",
          "interval": "1m"
        },
        {
          "refId": "B",
          "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
          "expr": "increase(rgp_worker_jobs_failed_total[$__interval])",
          "legendFormat": "failed",
          "interval": "1m"
        },
        {
          "refId": "C",
          "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
          "expr": "increase(rgp_worker_jobs_retried_total[$__interval])",
          "legendFormat": "retried",
          "interval": "1m"
        }
      ]
    }
  ]
}
