#
# Application's env var, injected to containers
# Github action env var & secrets ovwerride this file for deployement workflow.
#
# for docker-compose, database hosts are the service names in docker-compose.yml
POSTGRES_HOST=postgis
SMTP_HOST=fake-smtp-server
REDIS_URL=redis://redis:6379/0

ADMIN_EMAIL=admin@example.org
ADMIN_PASS=admin

# you can change the directory to wherever you want the data to reside on the host
# MUST be an absolute path
# EDIT: Shouldn't be needed in fact, at least for the web app,
# since it checks if it's a docker env and sets it to /app/data
# DATA_DIR=/home/nilsnolde/dev/gis-ops/routing-graph-packager/data
POSTGRES_DB=gis
POSTGRES_USER=admin
POSTGRES_PASS=admin

# If you need a SSL certificate to be respected on the gunicorn level
# Paths are local to the container (/app/ssl is mapped in docker-compose)
# Is put certs in /data/certs. A Volume is configured to read there. 
SSL_CERT='ssl/server.crt'
SSL_KEY='ssl/server.key'

# Graph build exclusive env vars
# How many threads to build tiles? Should be two less than available threads
CONCURRENCY=8
MAX_CACHE_SIZE=1000000000

# When to build a new graph, standard 5-field cron. Default is Sundays at 03:00.
GRAPH_BUILD_CRON=0 3 * * 0
# How many graph generations to keep on disk. 1 means only the one currently served,
# so a build transiently needs room for two planet graphs.
GRAPH_KEEP_GENERATIONS=1
# How long to wait for a running packaging job before giving up on a build, in seconds.
GRAPH_PRUNE_TIMEOUT=3600
# How long a lock on a graph directory stays valid, in seconds. Nothing renews it, so a builder or
# a packaging job that dies blocks its directory until this runs out. Keep it shorter than the
# interval between builds. Default is 4 days.
GRAPH_LOCK_TTL=345600

USE_ELEVATION=false
PBF_LOCAL_PATH=/app/tmp_data/planet-latest.osm.pbf
PBF_URL=https://planet.openstreetmap.org/pbf/planet-latest.osm.pbf
